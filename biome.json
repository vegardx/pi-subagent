{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"files": {
		"includes": ["**", "!node_modules", "!coverage", "!.pi"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
