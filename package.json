{
	"name": "@vegardx/pi-subagent",
	"version": "0.20.0",
	"description": "Native Gondolin-isolated subagent runtime for Pi.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"docs",
		"skills",
		"README.md",
		"LICENSE",
		"LICENSES",
		"THIRD_PARTY_NOTICES.md"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./service-provider": {
			"types": "./dist/service-provider.d.ts",
			"import": "./dist/service-provider.js"
		},
		"./ceiling-provider": {
			"types": "./dist/ceiling-provider.d.ts",
			"import": "./dist/ceiling-provider.js"
		},
		"./session-model-provider": {
			"types": "./dist/session-model-provider.d.ts",
			"import": "./dist/session-model-provider.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/extension.js"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "husky && npm run build",
		"check": "biome check . && tsc --noEmit && vitest run && npm run pack:check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"qualify:gondolin": "tsx spike/gondolin/qualify.ts",
		"pack:check": "node scripts/check-pack.mjs"
	},
	"engines": {
		"node": ">=23.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=1.4.0 <2",
		"@earendil-works/pi-ai": ">=1.4.0 <2",
		"@earendil-works/pi-coding-agent": ">=1.4.0 <2",
		"@earendil-works/pi-tui": ">=1.4.0 <2",
		"typebox": "*"
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.14.0",
		"ajv": "8.20.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@earendil-works/pi-agent-core": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "24.13.3",
		"@vegardx/pi-web": "file:../pi-web",
		"husky": "9.1.7",
		"tsx": "4.23.12",
		"typebox": "1.3.14",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"overrides": {
		"@earendil-works/pi-coding-agent": {
			"undici": "^8.12.3",
			"minimatch": "^11.0.0"
		}
	}
}
